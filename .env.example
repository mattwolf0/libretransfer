LIBRETRANSFER_ENVIRONMENT=development
LIBRETRANSFER_DATABASE_PATH=./data/libretransfer.db
LIBRETRANSFER_CONFIG_PATH=./config.json
LIBRETRANSFER_WEB_PATH=./apps/web/dist
LIBRETRANSFER_ADMIN_USER=admin
LIBRETRANSFER_ADMIN_PASSWORD=change-this
LIBRETRANSFER_COOKIE_SECURE=false
LIBRETRANSFER_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LIBRETRANSFER_TRUSTED_HOSTS=["localhost","127.0.0.1"]
LIBRETRANSFER_MAX_UPLOAD_MB=4096
LIBRETRANSFER_UPLOAD_SESSION_HOURS=24
LIBRETRANSFER_LOG_LEVEL=info
LIBRETRANSFER_FILES_PATH=./share

# Production example:
# LIBRETRANSFER_ENVIRONMENT=production
# LIBRETRANSFER_DATABASE_PATH=/app/data/libretransfer.db
# LIBRETRANSFER_CONFIG_PATH=/app/config.json
# LIBRETRANSFER_WEB_PATH=/app/apps/web/dist
# LIBRETRANSFER_ADMIN_PASSWORD=use-a-long-random-password
# LIBRETRANSFER_COOKIE_SECURE=true
# LIBRETRANSFER_ALLOWED_ORIGINS=["https://files.example.com"]
# LIBRETRANSFER_TRUSTED_HOSTS=["files.example.com","localhost","127.0.0.1"]
